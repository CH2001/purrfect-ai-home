# Copy to .env for local development. Never commit the filled-in .env.
# demo = local browser persistence; gcp = Firebase sign-in and authenticated API.
VITE_APP_MODE=demo
APP_MODE=demo

# PUBLIC browser identifiers, available from terraform output -json browser_config.
# These are embedded in the JS bundle. Never place a secret in a VITE_ variable.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Server-only configuration. Cloud Run receives these from Terraform.
GOOGLE_CLOUD_PROJECT=
AI_PROVIDER=mock
GCP_LOCATION=global
GEMINI_MODEL_ID=
AI_DAILY_LIMIT=40
DEMO_GUEST_ACCESS=true

# Google authentication: no JSON service-account keys and no Gemini API key needed.
# Local: gcloud auth application-default login (prefer service-account impersonation).
# Cloud Run: Application Default Credentials use the assigned runtime service account.
# Optional future third-party token: local .env only; production Secret Manager.
# PARTNER_API_TOKEN=
